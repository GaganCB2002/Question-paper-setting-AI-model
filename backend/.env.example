# App
APP_NAME=KKE Question Paper Generator
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://question-paper-setting-ai-model.vercel.app"]

# Database — Supabase (PostgreSQL) or SQLite (local dev)
# For SQLite: set USE_SQLITE=1 (DATABASE_URL / SUPABASE_DB_URL not needed)
# For Supabase: uncomment with your Supabase connection string
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.<project>.supabase.co:5432/postgres
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@db.<project>.supabase.co:5432/postgres
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_KEY=service-role-key
# SUPABASE_DB_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres

# Local dev fallback (when SUPABASE_DB_URL & USE_SQLITE are unset)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kke_qp_generator

# Redis (optional, for Celery)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OCR
TESSERACT_CMD=tesseract

# File uploads
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO
