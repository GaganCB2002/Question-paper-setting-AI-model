# App
APP_NAME=KKE Question Paper Generator
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://question-paper-setting-ai-model.vercel.app"]

# Database — Supabase (PostgreSQL) or SQLite (local dev)
# For SQLite: set USE_SQLITE=1 (no changes needed to DATABASE_URL / SUPABASE_DB_URL)
# For Supabase: uncomment below with your Supabase connection string
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kke_qp_generator

# Redis (optional, for Celery)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OCR
TESSERACT_CMD=tesseract

# File uploads
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO
